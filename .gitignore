node_modules
/uploads
.env
.env.*

# Copias de seguridad y archivos de estudios: son datos de pacientes,
# nunca van al repositorio.
backups/
uploads/

# Estado local del agente de la caja DICOM (qué ya subió) y su configuración
# con el token — nunca al repositorio.
caja-dicom/subidos.json
caja-dicom/config.json

# Estáticos precomprimidos: se generan solos al arrancar el servidor.
*.br

# Paquetes de idioma: se arman solos al arrancar, a partir de public/i18n/<idioma>/.
# Tener el generado en git garantiza que algún día quede desincronizado del original.
/public/i18n/*.js

# Mapas del JS ofuscado (scripts/ofuscar.js): tienen el código legible
# adentro. Se generan en cada despliegue y no se publican.
ofuscado-mapas/
